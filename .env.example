# ==============================================================================
# NEXUS - Digital Monoculture & Systemic Risk Observatory
# Environment Configuration Template
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# GitHub API Credentials (Optional for public rate limits, recommended for scanning)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_API_URL=https://api.github.com

# Neo4j Graph Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexus_secure_password
NEO4J_DATABASE=neo4j

# AI Engine & Model Router Configuration
# Supported providers: openai | anthropic | local
AI_MODEL_PROVIDER=openai
AI_CONFIDENCE_THRESHOLD=0.75
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_DEFAULT_MODEL=gpt-4o
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20240620
LOCAL_MODEL_URL=http://localhost:11434
LOCAL_DEFAULT_MODEL=llama3:8b

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
